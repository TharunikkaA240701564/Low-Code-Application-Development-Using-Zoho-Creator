		workflow
		{
		form
		{
			Block_Future_Incident_Dat as "Block_Future_Incident_Date"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Date_Of_Incident != null && input.Date_Of_Incident > zoho.currentdate)
										{
											alert "Date of Incident cannot be a future date.";
											cancel submit;
										}
						)
					}
				}

			}
			Block_Negative_Numbers as "Block_Negative_Numbers"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Claim_Amount_Requested != null && input.Claim_Amount_Requested <= 0)
										{
											alert "Claim Amount Requested must be a positive value.";
											cancel submit;
										}
						)
					}
				}

			}
			Validate_Repair_Cost_And_ as "Validate_Repair_Cost_And_Depreciation"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.Estimated_Repair_Cost != null && input.Estimated_Repair_Cost < 0)
										{
											alert "Estimated Repair Cost cannot be negative.";
											cancel submit;
										}
										if(input.Depreciation_Percent != null && input.Depreciation_Percent < 0 || input.Depreciation_Percent > 50)
										{
											alert "Depreciation Percent must be between 0 and 50.";
											cancel submit;
										}
						)
					}
				}

			}
			Autofill_Policy_Details as "Autofill_Policy_Details"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add or edit

				on user input of Policy_Details_Lookup
				{
					actions 
					{
						custom deluge script
						(
											if(input.Policy_Details_Lookup != null)
										{
											policyRec = Policies[ID == input.Policy_Details_Lookup];
											input.Policy_Sum_Insured_Lakhs = policyRec.Sum_Insured_Lakhs;
											input.Policy_Deductible = policyRec.Policy_Deductible;
										}
						)
					}
				}

			}
			Load_Claim_Guidelines as "Load_Claim_Guidelines"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											input.Claim_Process_Guidelines_Display = "<b>Claim Process Guidelines</b><ul><li>Keep all original bills and estimates.</li><li>A surveyor will contact you within 48 hours.</li><li>Do not repair the vehicle before inspection.</li></ul>";
						)
					}
				}

			}
		}

		schedule
		{
			Daily_Missing_Document_Re as "Daily_Missing_Document_Reminder_Schedule"
			{
				type =  schedule
				start = "2026-11-10 10:00:00"
				frequency = daily
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						pending = Claim_Request_Form[Repair_Estimate_Upload == null && Status != "Settled" && Status != "Rejected"];
										for each  r in pending
										{
											if(r.Email_Address != null)
											{
												sendmail
												[
													from :zoho.adminuserid
													to :r.Email_Address
													subject :"Documents pending for " + r.Claim_Reference_ID
													message :"Please upload your repair estimate to proceed with your claim."
												]
											}
										}
					)
					}
				}
			}
		}

		approval
		{
			HighValue_Claim_Approval as "HighValue_Claim_Approval"
			{
				type =  approval
				form = Claim_Request_Form[Net_Payable_Amount > 100000]
				display fields = [Claimant_Name,Claimant_Type,Policy_Number,Email_Address,Contact_Number,Residential_Address,Claim_Type]
				on start
				{
					actions 
					{
					on load
					(
						input.Status = "Pending Senior Approval";
					)
					}
				}
				on level 1
				{
					on approve 
					{
						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been approved."
							)
						}
						actions 
						{
						on load
						(
							input.Status = "Approved";
						)
						}
					}
					on reject
					{

						actions 
						{
							sendmail
							(
								from : zoho.loginuserid
								to : approver.submitter
								subject : "Approval Request"
								message : "Your request has been rejected."
							)
						}
						actions 
						{
						on load
						(
							input.Status = "Rejected";
						)
						}
						actions 
						{
						on load
						(
							input.Status = "Rejected";
						)
						}
					}
				}
			}
		}

		blueprint
		{
    			Claim_Lifecycle_Blueprint as "Claim_Lifecycle_Blueprint"
    			{
        			type = Blueprint
        			form = Claim_Request_Form
        			start
        			{
            			start stage = "Submitted"
            			chart data
            			{
                			from port : B
                			to port   : T3
                			position  : "-31 0"
                			path      : [-3.150000000000004,36.84,-3.150000000000004,46.84,-3.150000000000004,48.42,-3.1499999999999986,48.42,-3.1499999999999986,50,-3.1499999999999986,60]
            			}
