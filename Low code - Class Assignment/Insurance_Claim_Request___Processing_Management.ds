 * Version      : 1.0
 */
 application "Insurance Claim Request & Processing Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Claim_Request_Form
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Claimant_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Claimant_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"Policyholder","Nominee","Third Party"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Policy_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			Residential_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Claim_Type
			(
				type = picklist
				maxchar = 100
				values = {"Motor Insurance","Health Insurance","Home Insurance","Life Insurance"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_Of_Incident
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Claim_Amount_Requested
			(
				type = number
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supporting_Documents_Available
			(
				type = list	
				values = {"Photographs","Police FIR Copy","Repair Estimate"}
				height = 60px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Incident_Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Preferred_Callback_Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Declaration_Of_Authenticity
			(
				type = checkboxes	
				values = {"I declare that the information provided is true and accurate"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Policy_Details_Lookup
			(
				type = picklist	
				values  = Policies.ID
    			displayformat = [Policy_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			Damage_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Estimate_Upload
			(
    			type = upload file
				browse = local_drive
				allowed file formats = {"pdf","jpg","png","jpeg"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Policy_Sum_Insured_Lakhs
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Estimated_Repair_Cost
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			Depreciation_Percent
			(
    			type = percentage
	 			row = 1
	 			column = 1   
				width = medium
			)
			Witness_Details
			(
				type = grid
				maxrow = 4
				Witness_Name
				(
    				type = text
					width = medium
				)
				Witness_Contact_Number
				(
    				type = text
					width = medium
				)
				Witness_Statement
				(
    				type = textarea
					height = 100px
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section1
			(
				type = section
				displayname = "Section"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Is_Third_Party_Involved
			(
    			type = checkbox
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			Claim_Process_Guidelines_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 3
	 			column = 1   
				width = medium
			)
			FIR_Copy_Online_Link
			(
    			type = url
				enable  linkname
	 			row = 3
	 			column = 1   
				width = medium
			)
			Accident_Scene_Video
			(
    			type = video
    			duration=60
	 			row = 3
	 			column = 1   
				width = medium
			)
			Incident_Voice_Statement
			(
     			type = audio
    			duration=60
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Claimant_Digital_Signature
			(
    			type = signature
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
			Claim_Submitted_On
			(
    			type = datetime
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 3
	 			column = 1   
				width = medium
			)
			Claim_Reference_ID
			(
    			type = autonumber
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Net_Payable_Amount
			(
				type = decimal
	 			row = 3
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Estimated_Repair_Cost - input.Estimated_Repair_Cost * input.Depreciation_Percent / 100 - input.Policy_Deductible
    						visibility = true
    			)
			)
			Policy_Deductible
			(
				type = INR
				format = commadotindian
	 			row = 3
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Claim_Tracking_QR_Code"
				value = "${Claim_Reference_ID}"
	 			row = 3
	 			column = 1   
				width = medium
			)
			Status
			(
				type = picklist
				maxchar = 100
				values = {"Submitted","Under Investigation","Approved","Settled","Rejected"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Investigation_Status
			(
				type = picklist
				maxchar = 100
				values = {"Not Started","In Progress","Completed"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			Surveyor_Assigned
			(
    			type = text
	 			row = 3
	 			column = 1   
				width = medium
			)
			Settlement_Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Paid","Failed"}
	 			row = 3
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Submitted","Under Investigation","Approved","Settled","Rejected"}
			}
		}
		form Policies
		{
			success message = "Policy Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Policy_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Coverage_Type
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Sum_Insured_Lakhs
			(
				type = decimal
				displayname = "Sum_Insured_Lakhs	"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Valid_Till
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Policy_Deductible
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Claim_Request_Form_Report
		{
			displayName = "Claim_Request_Form Report"
			show all rows from Claim_Request_Form    
			(
				Claimant_Name 
				Claimant_Type
				Policy_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Type
				Date_Of_Incident
				Claim_Amount_Requested
				Supporting_Documents_Available
				Incident_Description
				Preferred_Callback_Time
				Declaration_Of_Authenticity
				Policy_Details_Lookup
				Damage_Photo
				Repair_Estimate_Upload
				Policy_Sum_Insured_Lakhs
				Estimated_Repair_Cost
				Depreciation_Percent
				Witness_Details.Witness_Name as "Witness_Details"
				Is_Third_Party_Involved
				Claim_Process_Guidelines_Display
				FIR_Copy_Online_Link
				Accident_Scene_Video
				Incident_Voice_Statement
				Claimant_Digital_Signature
				Claim_Submitted_On
				Claim_Reference_ID
				Policy_Deductible
				Net_Payable_Amount
				QR_Code as "Claim_Tracking_QR_Code"
				Status
				Investigation_Status
				Surveyor_Assigned
				Settlement_Status
			)
		}
		default list All_Policies
		{
			displayName = "All Policies"
			show all rows from Policies    
			(
				Policy_Number
				Coverage_Type
				Sum_Insured_Lakhs as "Sum_Insured_Lakhs	"
				Valid_Till
				Policy_Deductible
			)
		}
		list All_Claims_List
		{
			displayName = "All_Claims_List"
			show all rows from Claim_Request_Form    
			(
